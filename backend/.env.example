NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=articles_db
DB_USER=articles_user
DB_PASSWORD=articles_pass

# Storage: "local" or "s3"
STORAGE_PROVIDER=local

# Local storage
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_BASE_URL=http://localhost:3001/uploads

# S3 storage (only needed if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=my-articles-bucket
S3_BASE_URL=https://my-articles-bucket.s3.amazonaws.com

# Content generator
GENERATOR_API_URL=https://jsonplaceholder.typicode.com/posts
GENERATOR_COUNT=5
